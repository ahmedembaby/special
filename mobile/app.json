{
  "expo": {
    "name": "Special",
    "slug": "special",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Special to access your photos to set your profile picture."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Special to use Face ID to unlock the app."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Special to find your contacts who are already on the app."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Special to share your location in chats."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Special to access your microphone for voice messages."
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "react-native-compressor"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.special.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6C4DF6"
      },
      "package": "com.special.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}

{
  "expo": {
    "name": "Special",
    "slug": "special",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Special to access your photos to set your profile picture."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Special to use Face ID to unlock the app."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Special to find your contacts who are already on the app."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Special to share your location in chats."
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#5B5CE2"
        }
      ],
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Special to access your microphone for voice messages."
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0D1222"
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.special.app",
      "bitcode": false
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0D1222"
      },
      "package": "com.special.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WAKE_LOCK",
        "android.permission.BLUETOOTH"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "51931f96-260a-4231-b444-a9debe264fda"
      }
    }
  }
}

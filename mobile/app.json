{
  "expo": {
    "name": "Special",
    "slug": "special",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/special-logo.svg",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Special to access your photos to set your profile picture."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Special to use Face ID to unlock the app."
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Special to find your contacts who are already on the app."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Special to share your location in chats."
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Special to access your microphone for voice messages."
        }
      ],
      "expo-video",
      [
        "expo-splash-screen",
        {
          "image": "./assets/special-splash.svg",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#0D1222"
        }
      ],
      "@config-plugins/react-native-webrtc"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.special.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/special-logo.svg",
        "backgroundColor": "#0D1222"
      },
      "package": "com.special.app"
    },
    "web": {
      "favicon": "./assets/special-logo.svg"
    }
  }
}

PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=echat
# Generate a unique random secret (at least 32 characters); never commit the real .env
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=30d
# Comma-separated exact trusted origins; e.g. https://app.example.com
CLIENT_URL=http://localhost:8081
# Optional: Redis (OTP store, token blacklist, socket adapter). Works without it.
REDIS_URL=redis://localhost:6379
# Comma-separated administrator phone numbers/user IDs; empty means no phone-based admins
ADMIN_PHONES=
# ADMIN_IDS=
# Development only: return the OTP in the response when WhatsApp is not linked
OTP_DEV_MODE=false
WHATSAPP_ENABLED=true
# WHATSAPP_SETUP_KEY=choose-a-long-random-string
# CHROME_PATH=C:\\Program Files\\Google\\Chrome\\Application\\chrome.exe

# --- Voice/video calls (optional TURN relay) ---
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_PASSWORD=secret

# --- Optional ---
# SENTRY_DSN=
# APP_NAME=Special
# SUPPORT_EMAIL=you@example.com
# MYMEMORY_EMAIL=you@example.com

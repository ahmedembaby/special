PORT=5000
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=echat
# Set false when the database is provisioned by MySQL/your hosting panel and
# the runtime user intentionally has no global CREATE DATABASE privilege.
# DB_AUTO_CREATE_DATABASE=false
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d
CLIENT_URLS=http://localhost:8081
# Production example: CLIENT_URLS=https://app.example.com,https://admin.example.com
# Optional for single-process development. When configured, Redis is required for shared OTP,
# attempt counters and token revocation state; a Redis outage fails these operations closed.
REDIS_URL=redis://localhost:6379
# Comma separated user ids that can use /api/admin
# Set explicitly to the admin phone numbers you trust (comma-separated).
ADMIN_PHONES=
# ADMIN_IDS=1
# Development only: return the OTP in the response when WhatsApp is not linked
OTP_DEV_MODE=true
# WhatsApp OTP delivery (set to false to disable the puppeteer client)
WHATSAPP_ENABLED=true
# Open http://<server>:5000/api/whatsapp/setup to scan the QR (from this machine, or with ?key=<WHATSAPP_SETUP_KEY>)
# WHATSAPP_SETUP_KEY=choose-a-long-random-string
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# --- Voice/video calls (optional TURN relay; without it calls work on the same Wi-Fi / most networks via STUN) ---
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_PASSWORD=secret

# --- Optional ---
# APP_NAME=Special       (shown on /privacy)
# SUPPORT_EMAIL=you@example.com
# MYMEMORY_EMAIL=you@example.com   (free: raises the translation quota)


# Optional AI assistant and voice transcription (server-side only)
# AI_API_KEY=your-provider-api-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
# AI_TRANSCRIPTION_MODEL=whisper-1
# AI_DAILY_REQUESTS=50        (per user per day)
# AI_DAILY_TOKENS=60000       (per user per day)
# AI_COST_PER_1K_TOKENS=0.0006 (for the admin cost estimate)

# Encrypted database backups: point this to persistent storage, not an ephemeral container filesystem.
BACKUP_DIR=/path/on/persistent-storage/special-backups
# Generate a 32-byte key with: openssl rand -hex 32 (keep it outside source control).
BACKUP_ENCRYPTION_KEY=

# Optional off-host encrypted backup copy (S3-compatible storage).
# BACKUP_S3_ENDPOINT=https://<account-or-endpoint>
# BACKUP_S3_BUCKET=special-backups
# BACKUP_S3_ACCESS_KEY=
# BACKUP_S3_SECRET_KEY=
# BACKUP_S3_REGION=auto
# BACKUP_S3_PREFIX=special-backups/
